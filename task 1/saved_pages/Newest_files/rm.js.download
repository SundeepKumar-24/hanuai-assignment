n-color);\n  display: none;\n  place-items: center;\n  font-weight: 700;\n  line-height: 1;\n}\n.rm-format[data-type='BDGS'].desktop-hovered .info-add-on-icon {\n  display: grid;\n}\n.rm-format[data-type='BDGS'].no-info-add-on-text .rm-info-add-on-container {\n  display: none !important;\n}\n/** 32x32px interactive area above the info icon**/\n.rm-format[data-type='BDGS'] .info-add-on-icon::before {\n  content: \"\";\n  position: absolute;\n  width: 32px;\n  height: 32px;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n}\n.rm-format[data-type='BDGS'] .info-add-on-text {\n  color: var(--light-color-mode-text-color);\n  font-size: 12px;\n  max-width: 180ch;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  -webkit-box-orient: vertical;\n  margin: 0;\n  text-align: left;\n  line-height: normal;\n  display: none;\n}\n.rm-format[data-type='BDGS'] .rm-info-add-on-container.desktop-hovered,\n.rm-format[data-type='BDGS'] .rm-info-add-on-container.mobile-grid-clicked {\n  background: var(--light-color-mode-background);\n}\n.rm-format[data-type='BDGS'] .rm-info-add-on-container.desktop-hovered .info-add-on-icon {\n  background: var(--light-color-mode-icon-color);\n  color: var(--dark-color-mode-icon-color);\n}\n.rm-format[data-type='BDGS'] .rm-info-add-on-container.desktop-hovered .info-add-on-text {\n  display: -webkit-box;\n}\n/* ------- Light color – Mobile ------- */\n.rm-format[data-type='BDGS'][data-viewport=\"mobile\"] .rm-info-add-on-container {\n  background: var(--light-color-mode-background);\n}\n.rm-format[data-type='BDGS'][data-viewport=\"mobile\"] .info-add-on-text {\n  display: -webkit-box;\n}\n.rm-format[data-type='BDGS'][data-viewport=\"mobile\"] .info-add-on-icon {\n  background: var(--light-color-mode-icon-color);\n  color: var(--dark-color-mode-icon-color);\n}\n/**------- light color - mobile grid -------**/\n.mobile-grid-layout.rm-format[data-type='BDGS'][data-viewport=\"mobile\"] .rm-info-add-on-container {\n  background: transparent;\